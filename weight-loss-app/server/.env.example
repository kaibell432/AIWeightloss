# Copy to server/.env for local development. On Render, set these under Environment.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Gemini API key from https://aistudio.google.com/apikey  (API_KEY also works)
GEMINI_API_KEY=

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: comma-separated model fallback list
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash-lite

# Optional: AI requests allowed per IP per 15 minutes (default 15)
# AI_RATE_LIMIT=15

# Optional: email export of saved meal plans
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
